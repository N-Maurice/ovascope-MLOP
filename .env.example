# Copy to .env and fill in. Never commit .env.
OVASCOPE_ADMIN_KEY=change-me-to-a-long-random-string   # operator key (X-API-Key) for scripts/Streamlit; web users sign in with accounts
API_CPUS=2                                             # CPU limit per API container (docker compose)
# OVASCOPE_API_URL=http://localhost:8000               # Streamlit -> API address when run outside Docker
# OVASCOPE_CORS_ORIGINS=http://localhost:5173          # extra browser origins allowed to call the API directly
